# Copia este archivo como server/.env y reemplaza los valores localmente.
# NUNCA subas el .env real al repositorio.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<usuario>:<contrasena>@<cluster>/librosya?retryWrites=true&w=majority
JWT_SECRET=<secreto-largo-aleatorio-minimo-32-caracteres>
# Duración de la sesión. Cerrar sesión o cambiar la contraseña la invalida antes.
JWT_EXPIRES_IN=2h
# Origen(es) exacto(s) del frontend, separados por coma
CLIENT_ORIGIN=http://localhost:3000

# paypal = PayPal Sandbox/Live  |  mock = pasarela simulada (solo desarrollo, prohibida en producción)
PAYMENT_PROVIDER=paypal
PAYPAL_CLIENT_ID=<sandbox-client-id>
PAYPAL_CLIENT_SECRET=<sandbox-client-secret>
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
CURRENCY=USD

# Intentos de login/registro por IP cada 15 min (súbelo solo durante pruebas automatizadas; máx. 200)
AUTH_RATE_LIMIT=20
# Registros por IP cada hora
REGISTER_RATE_LIMIT=10
# Saltos de proxy de confianza para la IP real. Railway: 1. Sin proxy: 0. Por defecto: 1 en producción, 0 en desarrollo.
# TRUST_PROXY=1

# Solo para `npm run seed`: contraseñas de las cuentas de prueba (10+ caracteres, letras y números).
# Sin estas variables el seed NO crea cuentas. No las subas al repositorio.
# SEED_ADMIN_PASSWORD=
# SEED_CLIENT_PASSWORD=
